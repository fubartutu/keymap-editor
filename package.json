{
  "name": "zmk-keymap-editor",
  "version": "2.0.0",
  "description": "Visual, Oryx-style configurator for ZMK keyboards (keymap, combos, macros, behaviours, Kconfig settings, build and flash). Fork of nickcoutsos/keymap-editor.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node server/index.ts --dev",
    "start": "node server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
